# Configuration des variables d'environnement pour GestAgro
# Copiez ce fichier vers .env et ajustez les valeurs selon votre environnement

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
DB_NAME=gestagro
DB_USER=gestagro_user
DB_PASSWORD=gestagro_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO/S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_HTTPS=False
MINIO_BUCKET_NAME=gestagro-dev

# OpenSearch
OPENSEARCH_URL=http://localhost:9200

# Email (pour production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@gestagro.com

# CORS (pour production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Sentry (pour production)
SENTRY_DSN=your-sentry-dsn-here
ENVIRONMENT=development

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
