# Configuration des variables d'environnement pour GestAgro
# Copiez ce fichier vers .env et ajustez les valeurs selon votre environnement

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
DB_NAME=gestagro
DB_USER=gestagro_user
DB_PASSWORD=gestagro_password
DB_HOST=localhost
DB_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO/S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_HTTPS=False
MINIO_BUCKET_NAME=gestagro-dev

# OpenSearch / Elasticsearch
OPENSEARCH_URL=http://localhost:9200
ELASTICSEARCH_URL=https://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=changeme
ELASTICSEARCH_FINGERPRINT=
ELASTICSEARCH_CA_CERTS=  # chemin absolu vers http_ca.crt (optionnel)
ELASTICSEARCH_VERIFY_CERTS=true  # mettre false en dev si besoin
KIBANA_URL=http://localhost:5601

# Email Configuration (Gmail SMTP)
# Pour utiliser Gmail : activer validation 2 étapes + créer mot de passe d'application
# En dev, backend par défaut = 'console'. Pour SMTP : EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=gestagrogab@gmail.com
EMAIL_HOST_PASSWORD=zsrugxpllafsjekq
DEFAULT_FROM_EMAIL=gestagrogab@gmail.com

# Support client (adresses où les clients peuvent écrire)
SUPPORT_EMAIL=gestagrogab@gmail.com
CONTACT_EMAIL=gestagrogab@gmail.com

# CORS (pour production)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Sentry (pour production)
SENTRY_DSN=your-sentry-dsn-here
ENVIRONMENT=development

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-here
